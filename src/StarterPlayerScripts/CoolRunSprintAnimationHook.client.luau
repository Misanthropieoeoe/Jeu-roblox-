-- Plays the "Walk" animation at walking speed and "Run" while sprinting
-- (Shift, speed 24). Generated by Lemonade; edit freely.
-- The clip's stride rate and torso lean scale live with the character's
-- actual speed (walk 16 -> sprint 24 -> barrage self-slow). Jumping and
-- landing hand off through the "Sprint Jump" / "Sprint Land" clips and
-- return into the sprint cycle once the character is moving again.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AnimationController = require(ReplicatedStorage:WaitForChild("AnimationController"))
-- "Run" = course écrite à la main ; remettre "Cool Run Sprint" pour
-- retrouver l'ancienne course.
local SPRINT = "Run"
-- Inclinaison max du corps vers l'avant au sprint (en degrés).
-- (Run est déjà penchée de 9°, ceci s'ajoute quand on va plus vite que 16.)
local SPRINT_LEAN = 4
local WALK = "Walk"
local JUMP = "Sprint Jump"
local LAND = "Sprint Land"

-- Reference speed the clip was authored for; sprint (24) plays ~1.5x faster.
local REFERENCE_SPEED = 16
-- Matches the land clip's recover window; the sprint blends back in as the
-- body rises out of the absorb crouch.
local LAND_SECONDS = 0.45
local STOP_DELAY = 0.25
-- Walk below this ground speed, sprint above (walk = 16, sprint = 24).
local SPRINT_THRESHOLD = 20

local function hookCharacter(character)
	local humanoid = character:WaitForChild("Humanoid")
	local rootPart = character:WaitForChild("HumanoidRootPart")
	local suppressSprintUntil = 0
	local stoppedSince = nil

	local function groundSpeed()
		local velocity = rootPart.AssemblyLinearVelocity
		return Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	end

	humanoid.StateChanged:Connect(function(_, newState)
		if newState == Enum.HumanoidStateType.Jumping then
			AnimationController.Play(JUMP)
		elseif newState == Enum.HumanoidStateType.Landed then
			AnimationController.Play(LAND)
			-- Hold off the sprint restart until the land recovery is nearly up.
			suppressSprintUntil = os.clock() + LAND_SECONDS
		end
	end)

	RunService.Heartbeat:Connect(function()
		-- En garde (Guard.client.luau) : on ne remplace pas l'animation Block
		if AnimationController.CurrentAnimation() == "Block" then
			stoppedSince = nil
			return
		end
		if humanoid:GetState() ~= Enum.HumanoidStateType.Running then
			stoppedSince = nil
			return
		end
		local speed = groundSpeed()
		if speed > 0.5 then
			stoppedSince = nil
			local wanted = speed >= SPRINT_THRESHOLD and SPRINT or WALK
			if AnimationController.CurrentAnimation() ~= wanted
				and os.clock() >= suppressSprintUntil then
				AnimationController.Play(wanted)
			end
			if AnimationController.CurrentAnimation() == SPRINT then
				local rate = math.clamp(speed / REFERENCE_SPEED, 0.55, 1.6)
				-- Extra forward lean ramps in past the reference speed (sprint).
				local lean = math.clamp((speed - REFERENCE_SPEED) / 12, 0, 1) * math.rad(SPRINT_LEAN)
				AnimationController.SetClipSpeed(SPRINT, rate, lean)
			elseif AnimationController.CurrentAnimation() == WALK then
				-- Stride follows speed (barrage self-slow walks slower).
				local rate = math.clamp(speed / REFERENCE_SPEED, 0.5, 1.3)
				AnimationController.SetClipSpeed(WALK, rate, 0)
			end
		else
			-- Standing still keeps the humanoid in Running state at zero speed;
			-- end the cycle once the character has clearly stopped.
			stoppedSince = stoppedSince or os.clock()
			local current = AnimationController.CurrentAnimation()
			if (current == SPRINT or current == WALK)
				and os.clock() - stoppedSince > STOP_DELAY then
				AnimationController.Stop(current)
			end
		end
	end)
end

local player = Players.LocalPlayer
if player.Character then
	hookCharacter(player.Character)
end
player.CharacterAdded:Connect(hookCharacter)
